{
  "name": "taoholder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-limits.mjs && node scripts/check-security.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:check": "tsx scripts/check-content.ts",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/adapters/supabase/database.types.ts"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.1",
    "@polkadot/extension-dapp": "^0.64.1",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
