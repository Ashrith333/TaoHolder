# Chain + network
NEXT_PUBLIC_CHAIN=mainnet            # mainnet | testnet | local
# Supabase (config + content). Leave empty to run on content/ JSON only.
NEXT_PUBLIC_SUPABASE_URL=https://qewsbecatbyguphoekab.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # only for `pnpm db:seed`, never exposed to the browser
# Data sources read their keys by env var name (data_sources.config.apiKeyEnv)
TAOSTATS_API_KEY=
# Optional fallbacks when no data_sources row exists
RPC_HTTP_URL=https://entrypoint-finney.opentensor.ai
NEXT_PUBLIC_RPC_WS_URL=wss://entrypoint-finney.opentensor.ai:443
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
